; Nasdaq Opening-Range Momentum - live settings (2026-09-27). Edit, then: systemctl restart gtb-mt5-nq
; Trades US100.cash every day at 0.75x the gold EA's risk: the opening-range trade plus the noise-area engine
; (one extra trade a day, 10:00-15:00 NY); no trade on Fed decision days; stop-and-reverse off.
InpRangeMinutes=15
InpStopFloorAtr=0.3
InpMinBodyFrac=0.2
InpExitHour=15
InpExitMinute=55
InpGate=0
InpRiskMult=0.75
InpSkipFomc=true
InpReverseOnce=false
InpReverseUntil=12
InpNoiseEngine=true
InpNoiseRiskMult=0.75
InpNoiseDays=14
; Afternoon break-even (research 2026-09-30, FTMO US100.cash M5 2021-09..2026-09: +147.4R vs +136.3R with the
; plain session exit, PF 1.15 -> 1.18): from 13:00 New York time, any position in profit by at least +0.5R
; gets its stop moved to the entry (+ a 0.015R buffer for costs). It touches ~11% of trades (80 better /
; 56 worse) and is what stops the "up 1R in the morning, negative at 15:55" give-backs. 0 = off (old behaviour).
InpBeAfterHour=13
InpBeAfterMinR=0.5
InpBeBufferR=0.015
InpMaxRiskPct=1.25
InpRiskDivisor=4
InpMinRiskPct=0.25
InpFixedRisk=false
InpFixedRiskPct=1.0
; InpInitialBalance: set to the account's STARTING balance for a paid account (same value as the gold preset)
InpInitialBalance=10000
InpPropRules=true
InpDailyLimitPct=2.5
InpTotalLimitPct=8.0
InpProfitTarget=10
InpServerMinusNY=7
InpServerMinusPrague=1
InpMagic=24240002
InpGoldMagic=24240001
InpDeviationPts=300
InpEventLog=true
